FROM php:8.2-fpm

RUN apt-get update && apt-get install -y \
    git \
    curl \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    zip \
    unzip \
    nginx \
    sqlite3 \
    libsqlite3-dev

RUN apt-get clean && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-install pdo_sqlite pdo_mysql mbstring exif pcntl bcmath gd

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

# Сначала копируем только composer файлы
COPY clarnetta-app/composer.json clarnetta-app/composer.lock ./

# Устанавливаем зависимости
RUN composer install --no-dev --optimize-autoloader --no-scripts

# Теперь копируем все остальные файлы
COPY clarnetta-app/ .

# Копируем конфигурацию nginx
COPY docker/nginx.conf /etc/nginx/sites-available/default

# Устанавливаем правильные права
RUN chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache

# Выполняем скрипты после копирования всех файлов
RUN composer run-script post-autoload-dump

EXPOSE 80

CMD ["sh", "-c", "nginx && php-fpm"]